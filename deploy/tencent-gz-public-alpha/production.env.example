# Copy to /etc/medtrust/production.env with mode 600.
COMPOSE_PROJECT_NAME=medtrust-public-alpha
MEDTRUST_BACKEND_IMAGE=medtrust-space-backend:0.14.0-alpha
MEDTRUST_GATEWAY_IMAGE=medtrust-space-gateway:0.14.0-alpha

# Pre-ICP default. Public mode is selected only by compose.public.yaml.
MEDTRUST_DEPLOYMENT_MODE=pre-icp
PRE_ICP_ENTRY_PORT=18080
MEDTRUST_PUBLIC_ORIGIN=http://127.0.0.1:18080
MEDTRUST_TRUSTED_ORIGINS=http://127.0.0.1:18080
MEDTRUST_CORS_ORIGINS=http://127.0.0.1:18080
MEDTRUST_ALLOWED_HOSTS=127.0.0.1,localhost,gateway
MEDTRUST_TRUSTED_PROXY_IPS=*

POSTGRES_DB=medtrust
POSTGRES_USER=medtrust

MEDTRUST_SESSION_LIFETIME_SECONDS=28800
MEDTRUST_PASSWORD_MIN_LENGTH=14
MEDTRUST_LOGIN_RATE_LIMIT_ATTEMPTS=5
MEDTRUST_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Fill only after ICP approval.
PUBLIC_DOMAIN=replace-after-icp.example.invalid
ICP_NUMBER=
ACME_EMAIL=off
HSTS_MAX_AGE=0

# Product boundary: hard_isolation=false; Synthetic/Public Non-clinical Alpha.
# The application has no self-registration route.
