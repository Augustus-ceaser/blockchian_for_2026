MEDTRUST_APP_NAME=MedTrust Space API
MEDTRUST_APP_ENV=development
MEDTRUST_DEBUG=true
MEDTRUST_API_V1_PREFIX=/api/v1
MEDTRUST_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Explicit opt-in. This enables only the fixed PathMNIST demo command.
MEDTRUST_DEMO_API_ENABLED=false
MEDTRUST_OUTBOX_PUBLISHER=unavailable

# Local host connection. Compose overrides the hostname with `postgres`.
MEDTRUST_DATABASE_URL=postgresql+asyncpg://medtrust:medtrust_dev_only@127.0.0.1:5432/medtrust
MEDTRUST_DATABASE_ECHO=false

# Dispatcher defaults to fail-closed. `in_memory` is development-only and is
# not a reliable external transport.
MEDTRUST_OUTBOX_PUBLISHER=unavailable
MEDTRUST_OUTBOX_BATCH_SIZE=50
MEDTRUST_OUTBOX_POLL_INTERVAL=1.0
MEDTRUST_OUTBOX_LEASE_SECONDS=60
MEDTRUST_OUTBOX_MAX_ATTEMPTS=10
MEDTRUST_OUTBOX_SHUTDOWN_TIMEOUT=30.0

# Metadata only in Phase 2-B.1; no MinIO client is implemented yet.
MEDTRUST_MINIO_ENDPOINT=127.0.0.1:9000
MEDTRUST_MINIO_ACCESS_KEY=medtrust
MEDTRUST_MINIO_SECRET_KEY=medtrust_dev_only
MEDTRUST_MINIO_SECURE=false

# Phase 5.4-5.6 Web3 local demonstration. Keep disabled until the four deployed
# addresses below are produced by `blockchain/scripts/deploy-local.ts`.
MEDTRUST_WEB3_ENABLED=false
MEDTRUST_WEB3_CHAIN_ID=31337
MEDTRUST_WEB3_RPC_URL=http://127.0.0.1:8545
MEDTRUST_WEB3_REQUIRED_CONFIRMATIONS=1
MEDTRUST_WEB3_SIWE_DOMAIN=127.0.0.1:5173
MEDTRUST_WEB3_SIWE_URI=http://127.0.0.1:5173
MEDTRUST_WEB3_CHALLENGE_TTL_SECONDS=300
# Keccak-256 of `medtrust:space:<canonical Phase 4 space UUID>`.
MEDTRUST_WEB3_SPACE_SCOPE_DIGEST=
MEDTRUST_WEB3_ROLE_CREDENTIAL_ADDRESS=
MEDTRUST_WEB3_AGREEMENT_REGISTRY_ADDRESS=
MEDTRUST_WEB3_ESCROW_ADDRESS=
MEDTRUST_WEB3_SETTLEMENT_TOKEN_ADDRESS=
MEDTRUST_WEB3_CREDENTIAL_ISSUER_ADDRESS=
MEDTRUST_WEB3_EXECUTION_ATTESTOR_ADDRESS=
MEDTRUST_WEB3_DELIVERY_ATTESTOR_ADDRESS=
MEDTRUST_WEB3_SETTLEMENT_TOKEN_DECIMALS=6
MEDTRUST_WEB3_ESCROW_REFUND_SECONDS=86400
MEDTRUST_WEB3_RPC_TIMEOUT_SECONDS=5
# Required outside local/roadshow after an independent review; never self-assert.
MEDTRUST_WEB3_SECURITY_REVIEW_DIGEST=
