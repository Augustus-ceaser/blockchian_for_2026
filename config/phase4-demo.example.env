# Copy this file to config/phase4-demo.env and fill in local paths.
# The local file is ignored by Git. Never commit it or share its password value.

MEDTRUST_PATHMNIST_DATASET_PATH=
MEDTRUST_PATHMNIST_MODEL_PATH=
MEDTRUST_MINIO_QUARANTINE_BUCKET=medtrust-phase56-quarantined-results
MEDTRUST_LOCAL_DEMO_PASSWORD=
MEDTRUST_DEMO_HOSPITAL_PASSWORD=
MEDTRUST_DEMO_MODEL_PASSWORD=
MEDTRUST_DEMO_REQUESTER_PASSWORD=
MEDTRUST_DEMO_OPERATOR_PASSWORD=
MEDTRUST_DEMO_CATALOG_CURATOR_PASSWORD=

# Keep this false. A separate Git-ignored local override may enable weak
# credentials only for the four public accounts in loopback-only demos.
MEDTRUST_ALLOW_WEAK_LOCAL_DEMO_CREDENTIALS=false

# Optional role-aware assistant planner. Keep the key in the Git-ignored
# config/.secrets/ directory, for example config/.secrets/openai-api-key.txt.
# With the default false value, the deterministic local planner remains active.
MEDTRUST_ROLE_ASSISTANT_OPENAI_ENABLED=false
MEDTRUST_ROLE_ASSISTANT_PROVIDER=openai
MEDTRUST_ROLE_ASSISTANT_OPENAI_API_KEY_FILE=
MEDTRUST_ROLE_ASSISTANT_OPENAI_MODEL=gpt-4.1-mini
MEDTRUST_ROLE_ASSISTANT_OPENAI_BASE_URL=https://api.openai.com/v1
MEDTRUST_ROLE_ASSISTANT_OPENAI_TIMEOUT_SECONDS=15
MEDTRUST_ROLE_ASSISTANT_RUNTIME=pydantic_ai
MEDTRUST_ROLE_ASSISTANT_REQUEST_LIMIT=3
MEDTRUST_ROLE_ASSISTANT_TOOL_CALL_LIMIT=4
MEDTRUST_ROLE_ASSISTANT_STATE_ENABLED=true
MEDTRUST_ROLE_ASSISTANT_SEMANTIC_SEARCH_ENABLED=false

# Optional executable overrides. PATH is checked before repository fallbacks.
MEDTRUST_NODE=
MEDTRUST_BACKEND_PYTHON=
MEDTRUST_EXECUTOR_PYTHON=

# Optional database overrides for the dedicated disposable roadshow database.
MEDTRUST_PHASE4_DATABASE_NAME=medtrust_phase4_demo
MEDTRUST_PHASE4_DATABASE_URL=postgresql+asyncpg://medtrust:medtrust_dev_only@127.0.0.1:5432/medtrust_phase4_demo
